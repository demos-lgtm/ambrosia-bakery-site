---
import Photo from "./Photo.astro";
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { SITE, T, type Lang } from "../data/site";
interface Props { lang: Lang; eyebrow: string; h1: string; h1em?: string; intro: string; facts?: string[]; photo?: string; img?: ImageMetadata; imgAlt?: string; imgPos?: string; caption?: boolean }
const { lang, eyebrow, h1, h1em, intro, facts = [], photo: k, img, imgAlt, imgPos, caption = true } = Astro.props;
const t = T[lang];
import { photo } from "../lib/photos";
const p = k ? photo(k) : null;
---
<section class="ohero">
  <div class="wrap">
    <div>
      <span class="label">{eyebrow}</span>
      <h1>{h1} {h1em && <em>{h1em}</em>}</h1>
      <p class="lead">{intro}</p>
      {facts.length > 0 && <div class="facts">{facts.map((f) => <span>{f}</span>)}</div>}
      <div class="ctas"><slot /></div>
      <a class="proof" href={SITE.reviewsUrl} rel="noopener">
        <span class="badge"><span><b>{lang === "fr" ? SITE.rating : SITE.ratingEn}</b><small>★★★★★</small></span></span>
        <p><strong>{t.reviewsLine(lang === "fr" ? "1 714" : "1,714")}.</strong> {lang === "fr" ? "Une pâtisserie familiale de Laval depuis 1995." : "A family bakery in Laval since 1995."}</p>
      </a>
    </div>
    <figure>
      {img
        ? <Picture src={img} alt={imgAlt ?? ""} formats={["webp"]} fallbackFormat="webp" widths={[480, 900, 1128]} sizes="(max-width: 860px) 100vw, 45vw" loading="eager" fetchpriority="high" decoding="async" quality={80} style={imgPos ? `object-position:${imgPos}` : undefined} />
        : <Photo k={k!} lang={lang} eager sizes="(max-width: 860px) 100vw, 45vw" />}
      {caption && !img && p && <figcaption>{p[lang]}</figcaption>}
      {caption && img && imgAlt && <figcaption>{imgAlt}</figcaption>}
    </figure>
  </div>
</section>
