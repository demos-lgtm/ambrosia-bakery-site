<script>
  const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-rf]")];
  const cards = [...document.querySelectorAll<HTMLElement>(".rcard[data-tags]")];
  chips.forEach((c) => c.addEventListener("click", () => {
    chips.forEach((o) => o.setAttribute("aria-pressed", String(o === c)));
    const f = c.dataset.rf!; cards.forEach((card) => (card.hidden = f !== "all" && !card.dataset.tags!.split(" ").includes(f)));
  }));
</script>
